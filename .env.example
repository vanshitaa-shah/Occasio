# ---- Backend ----
PORT=3001

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://occasio:occasio@localhost:5432/occasio?schema=public"

# SMTP — dev defaults target Mailhog (no auth). SMTP_FROM is the FIXED verified
# sender ("From"); the card owner's address is used as Reply-To (you can't send
# *as* an arbitrary user — SPF/DKIM/DMARC). Attribution shows on the card image.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Occasio <no-reply@occasio.local>"
# SMTP_SECURE=false          # true for port 465 (TLS)
# SMTP_USER=                 # set for a real provider (see below)
# SMTP_PASS=
#
# To send real email, point these at a provider's SMTP + a VERIFIED sender:
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_SECURE=false
#             SMTP_USER=<Brevo account login email> SMTP_PASS=<SMTP key>
#             SMTP_FROM="You <you@your-verified-sender>"
#   SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587
#             SMTP_USER=apikey            SMTP_PASS=<API key>
#             SMTP_FROM="You <your-verified-sender>"
#
# BREVO_API_KEY (optional) — set this to send via Brevo's HTTP API instead of
# raw SMTP. When set it takes priority over SMTP_* above (SMTP_FROM is still
# used as the sender). Use this on hosts that block outbound SMTP ports (e.g.
# Render's free plan) — get the key from Brevo → SMTP & API → API Keys tab
# (NOT the SMTP key used for SMTP_PASS).
# BREVO_API_KEY=

# URL of the frontend render route the headless browser loads (Phase 3)
RENDER_BASE_URL="http://localhost:5173"

# Scheduler poll interval in ms (optional; default 60000). Lower it for testing.
# SCHEDULER_POLL_MS=60000

# ---- Frontend ----
VITE_API_BASE_URL="http://localhost:3001"

# Auth
JWT_SECRET="dev-only-change-me-please"
