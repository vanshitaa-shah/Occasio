# ---- Backend ----
PORT=3001

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://occasio:occasio@localhost:5432/occasio?schema=public"

# SMTP (Mailhog local inbox — matches docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Occasio <no-reply@occasio.local>"

# URL of the frontend render route the headless browser loads (Phase 3)
RENDER_BASE_URL="http://localhost:5173"

# Scheduler poll interval in ms (optional; default 60000). Lower it for testing.
# SCHEDULER_POLL_MS=60000

# ---- Frontend ----
VITE_API_BASE_URL="http://localhost:3001"

# Auth
JWT_SECRET="dev-only-change-me-please"
