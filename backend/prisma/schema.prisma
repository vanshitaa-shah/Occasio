generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardStatus {
  PENDING
  SENT
  FAILED
}

/// A scheduled greeting card. `design` holds the full CanvasDesign JSON
/// (@occasio/shared) that the headless renderer rebuilds at send time.
model Card {
  id        String     @id @default(cuid())
  recipient String
  sendAt    DateTime
  status    CardStatus @default(PENDING)
  design    Json
  error     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sentAt    DateTime?

  // The scheduler polls on (status, sendAt) — index it.
  @@index([status, sendAt])
}
